<Project>
  <PropertyGroup>
    <!-- When built within the MultiDisplayVCP mono-repo, redirect to BuildOut\Client unconditionally to keep Source clean -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\BuildOut\Client\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\BuildOut\Client\obj\</BaseIntermediateOutputPath>

    <!-- Ensure trailing slashes for MSBuild safety when redirected -->
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
</Project>
