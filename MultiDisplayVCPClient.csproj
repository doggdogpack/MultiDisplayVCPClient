<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>DoggoDogPack</Authors>
    <Version>3.0.0</Version>
    <PackageId>DoggoDogPack.MultiDisplayVCPClient</PackageId>
    <RepositoryUrl>https://github.com/doggdogpack/MultiDisplayVCPClient</RepositoryUrl>
    <Product>Multi-Display VCP Client</Product>
    <AssemblyName>MultiDisplayVCPClient</AssemblyName>
    <RootNamespace>MultiDisplayVCPClient</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MacroDeck.Plugin.Analyzers" Version="3.0.0-beta.15" PrivateAssets="all" />
    <PackageReference Include="MacroDeck.Localization" Version="3.0.0-beta.15" />
    <PackageReference Include="MacroDeck.Plugin.Hosting" Version="3.0.0-beta.15" />
    <PackageReference Include="MacroDeck.Plugin.Serilog" Version="3.0.0-beta.15" />
    <PackageReference Include="MacroDeck.Sdk" Version="3.0.0-beta.15" />
    <PackageReference Include="MagicOnion.Client" Version="7.11.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
  </ItemGroup>



  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>